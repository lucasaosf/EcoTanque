<?xml version="1.0" encoding="utf-8"?>
<!-- 
  BLINDAGEM DE REDE ECOTANQUE
  Bloqueia qualquer conexão não criptografada (HTTP plano)
  Exige TLS seguro com certificados válidos do sistema operacional
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
